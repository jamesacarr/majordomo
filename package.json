{
  "name": "majordomo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Household agent on Telegram that routes requests to home services, starting with Seerr media requests",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "SEERR_URL=http://127.0.0.1:47231 SEERR_API_KEY=eval-api-key MAJORDOMO_DEV_USER='Eval Tester' eve eval",
    "lint": "biome check --write .",
    "lint:ci": "biome check .",
    "prepare": "husky",
    "start": "eve start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ai": "^7.0.143",
    "eve": "^0.81.1",
    "just-bash": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "24.x",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
