# Copy to .env for `eve dev`. In production these live in the Vercel project environment.

# ----- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=                  # from BotFather
TELEGRAM_WEBHOOK_SECRET_TOKEN=       # random string; must match the setWebhook secret_token

# ----- Seerr -----------------------------------------------------------------
SEERR_URL=https://seerr.example.invalid
SEERR_API_KEY=                       # Seerr > Settings > General > API Key

# ----- majordomo -------------------------------------------------------------
# JSON map of Telegram user id -> Seerr user id (a number, not a string). The bot
# acts as that Seerr user, so their permissions, approval rules and quota apply.
# Two Telegram ids may share one Seerr id. Names come from Telegram.
MAJORDOMO_ALLOWED_USERS={"123456789":2}

# ----- Local development only ------------------------------------------------
# Seerr user id that sessions with no Telegram identity (eve dev TUI, evals) act as.
# Ignored unless EVE_DEV=1, which `eve dev` sets.
MAJORDOMO_DEV_SEERR_USER_ID=
# AI Gateway key for eve dev and eve eval. Production uses Vercel OIDC instead.
AI_GATEWAY_API_KEY=
